{
	"name": "note-navigator",
	"version": "1.2.1",
	"description": "Deleting a file was distracting, now you continue to the next note",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"dev:build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs dev",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lintfix": "eslint --fix src/**/*.ts",
		"lint": "eslint src/**/*.ts"
	},
	"keywords": [],
	"author": "",
	"license": "GPL-3.0",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"esbuild": "^0.25.1",
		"eslint": "^10.3.0",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"eslint-plugin-perfectionist": "^5.0.0",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.3.0"
	}
}
