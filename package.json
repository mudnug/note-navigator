{
  "name": "note-navigator",
  "version": "1.9.0",
  "description": "Deleting a file was distracting, now you continue to the next note",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "dev:build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs dev",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lintfix": "eslint --fix src/**/*.ts",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-perfectionist": "^5.12.1",
    "obsidian": "1.14.4",
    "tslib": "2.8.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "fast-uri": "^3.1.0"
  }
}
